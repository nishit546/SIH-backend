generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserRole {
  REVIEWER
  MANAGER
  ANALYST
  ADMIN
}

enum ReportType {
  UNSAFE_ACT
  UNSAFE_CONDITION
  NEAR_MISS
  INCIDENT
}

enum ProcessingStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PatternType {
  RECURRING_CONTROL_FAILURE
  HIGH_RISK_CLUSTER
  LOCATION_HOTSPOT
  EMERGING_TREND
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  fullName     String
  role         UserRole  @default(REVIEWER)
  department   String?
  site         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  safetyReports   SafetyReport[]
  assignedActions CorrectiveAction[] @relation("AssignedActions")
  createdActions  CorrectiveAction[] @relation("CreatedActions")

  @@map("users")
}

model SafetyReport {
  id             String           @id @default(uuid())
  reportNumber   String?          @unique // e.g. "REP-2026-0001"
  description    String           @db.Text // Original free-text observation
  reportType     ReportType       // Unsafe Act, Unsafe Condition, Near Miss, Incident
  site           String           // Location / Facility / Rig / Plant
  department     String?          // Operations, Maintenance, Drilling, etc.
  activity       String           // Hot work, Lifting, Confined space entry, etc.
  contractorType String?          // Internal, Contractor, Third Party
  workPhase      String?          // Operations, Maintenance, Construction, etc.
  eventDate      DateTime         @default(now()) // When the observation occurred
  status         ProcessingStatus @default(PENDING) // Analysis workflow state
  reporterId     String?
  sourceMetadata Json?            // For public dataset/batch ingestion origin details
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relationships
  reporter        User?                 @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  analyses        SafetyAnalysis[]
  actions         CorrectiveAction[]
  patternMappings SafetyPatternReport[]

  // High-traffic querying & filtering indexes
  @@index([reportType])
  @@index([site])
  @@index([activity])
  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
  @@map("safety_reports")
}

model SafetyAnalysis {
  id                    String    @id @default(uuid())
  reportId              String
  sifPotential          Boolean   // Binary SIF precursor flag
  probability           Float     // Model confidence / SIF score (0.0 to 1.0)
  riskLevel             RiskLevel // Evaluated risk level: LOW, MEDIUM, HIGH, CRITICAL
  hazards               Json      // Detected energy/hazards (e.g. ["Hot Work", "Pressure"])
  exposures             Json      // Exposed personnel/locations (e.g. ["Maintenance Worker"])
  criticalControls      Json      // Identified controls/barriers (e.g. ["Gas Testing", "PTW"])
  controlFailures       Json      // Specific barrier breakdowns (e.g. ["Gas testing incomplete"])
  barrierStatus         String?   // Bypassed, Missing, Ineffective, Not Verified
  potentialConsequences Json      // Potential outcomes (e.g. ["Explosion", "Fatality"])
  iogpRules             Json      // Mapped IOGP Life-Saving Rules (e.g. ["Hot Work"])
  explanation           String    @db.Text // Human-interpretable rationale for why flagged
  modelVersion          String    @default("v1.0.0") // AI engine version for reproducibility
  ontologyVersion       String?   @default("v1.0.0") // Safety ontology version
  isLatest              Boolean   @default(true) // Marks the primary/current analysis for dashboard queries
  rawResponse           Json?     // Verbatim model output payload for audit & retraining
  createdAt             DateTime  @default(now())

  // Relationships
  report SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Indexes for dashboard analytics & filtering
  @@index([reportId])
  @@index([sifPotential])
  @@index([riskLevel])
  @@index([isLatest])
  @@index([modelVersion])
  @@index([createdAt])
  @@map("safety_analyses")
}

model CorrectiveAction {
  id          String         @id @default(uuid())
  reportId    String
  title       String
  description String?        @db.Text
  priority    ActionPriority @default(MEDIUM)
  status      ActionStatus   @default(OPEN)
  assigneeId  String?
  createdById String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relationships
  report   SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assignee User?        @relation("AssignedActions", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User?        @relation("CreatedActions", fields: [createdById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([reportId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("corrective_actions")
}

model SafetyPattern {
  id              String      @id @default(uuid())
  title           String      // e.g. "Hot Work Control Failures at Plant A"
  description     String?     @db.Text
  hazardCategory  String?     // e.g. "Hot Work"
  iogpRule        String?     // e.g. "Hot Work"
  site            String?     // e.g. "Plant A"
  activity        String?     // e.g. "Welding"
  riskLevel       RiskLevel   @default(HIGH)
  reportCount     Int         @default(1)
  patternType     PatternType @default(RECURRING_CONTROL_FAILURE)
  firstDetectedAt DateTime    @default(now())
  lastDetectedAt  DateTime    @default(now())
  status          String      @default("ACTIVE") // ACTIVE, REVIEWED, MITIGATED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  reports SafetyPatternReport[]

  // Indexes
  @@index([site])
  @@index([iogpRule])
  @@index([patternType])
  @@index([status])
  @@index([lastDetectedAt])
  @@map("safety_patterns")
}

model SafetyPatternReport {
  id         String   @id @default(uuid())
  patternId  String
  reportId   String
  confidence Float?   // Pattern association confidence score
  linkedAt   DateTime @default(now())

  // Relationships
  pattern SafetyPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  report  SafetyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([patternId, reportId])
  @@index([patternId])
  @@index([reportId])
  @@map("safety_pattern_reports")
}
