# ==============================================================================
# HSE Safety Intelligence Platform - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Database Connection (MySQL / PostgreSQL supported via Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/sih_backend"

# AI / NLP Reasoning Engine Integration
AI_PROVIDER=mock                      # Options: 'mock' | 'real'
AI_SERVICE_URL=http://127.0.0.1:8000   # URL of Python / FastAPI NLP Engine
AI_REQUEST_TIMEOUT_MS=10000
AI_MODEL_VERSION=sif-nlp-v2.1

# JWT Authentication
JWT_SECRET="sih_ps165_super_secret_jwt_key_2026_oil_gas_safety"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="sih_ps165_super_secret_refresh_key_2026_oil_gas_safety"
REFRESH_TOKEN_EXPIRES_IN="7d"



# ------------------------------------------------------------------------------
# Frontend Application Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api
VITE_USE_MOCK=false
